<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="overlayPane" stylesheets="@../css/theme.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.investigation.controller.AnomaliesController"
           style="-fx-background-color: #F1F5F9;">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F1F5F9;">
        <VBox spacing="18.0" style="-fx-padding: 24px;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="⚠️" style="-fx-font-size: 18px; -fx-text-fill: #0F172A;"/>
                    <Label text="Anomalies" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="activeCaseHeaderLabel" text="[Case C-001]"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #EFF6FF; -fx-padding: 3px 8px; -fx-background-radius: 6px;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search -->
                <HBox alignment="CENTER_LEFT" spacing="6.0"
                      style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 2 10 2 10;">
                    <Label text="🔍" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                    <TextField fx:id="searchField" promptText="Search anomaly patterns..." prefWidth="180.0"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 6 0 6 0; -fx-font-size: 12px;"/>
                </HBox>

                <ComboBox fx:id="severityFilterComboBox" prefWidth="130.0" promptText="Severity"/>

                <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary"/>
            </HBox>

            <!-- Top Charts Section (Matches Reference Image Panel 9) -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="48.0"/>
                    <ColumnConstraints percentWidth="52.0"/>
                </columnConstraints>

                <!-- Left: Anomaly Distribution Donut / Pie Chart Card -->
                <VBox GridPane.columnIndex="0" spacing="12.0" styleClass="white-card">
                    <Label text="Anomaly Distribution" styleClass="section-title"/>

                    <HBox alignment="CENTER" spacing="16.0">
                        <!-- Chart with centered total overlay -->
                        <StackPane prefWidth="220.0" prefHeight="180.0">
                            <PieChart fx:id="distributionPieChart" legendVisible="false" labelsVisible="false"
                                      prefWidth="200.0" prefHeight="180.0"/>
                            <!-- Center Donut Cutout Badge -->
                            <VBox alignment="CENTER" spacing="1.0"
                                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 50%; -fx-min-width: 60px; -fx-min-height: 60px; -fx-max-width: 60px; -fx-max-height: 60px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 6, 0, 0, 1);">
                                <Label fx:id="donutTotalLabel" text="27" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                                <Label text="Total" style="-fx-font-size: 9px; -fx-text-fill: #64748B;"/>
                            </VBox>
                        </StackPane>

                        <!-- Legend Items (Red Critical, Orange High, Yellow Medium, Blue Low) -->
                        <VBox spacing="8.0" alignment="CENTER_LEFT">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="●" style="-fx-text-fill: #DC2626; -fx-font-size: 13px;"/>
                                <Label fx:id="legendCritical" text="Critical 4" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #334155;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="●" style="-fx-text-fill: #EA580C; -fx-font-size: 13px;"/>
                                <Label fx:id="legendHigh" text="High 9" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #334155;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="●" style="-fx-text-fill: #D97706; -fx-font-size: 13px;"/>
                                <Label fx:id="legendMedium" text="Medium 8" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #334155;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="●" style="-fx-text-fill: #0284C7; -fx-font-size: 13px;"/>
                                <Label fx:id="legendLow" text="Low 6" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #334155;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Right: Anomaly Trend Line Chart Card -->
                <VBox GridPane.columnIndex="1" spacing="8.0" styleClass="white-card">
                    <Label text="Anomaly Trend" styleClass="section-title"/>
                    <LineChart fx:id="trendLineChart" legendVisible="false" prefHeight="180.0">
                        <xAxis>
                            <CategoryAxis label="Timeline" fx:id="trendXAxis"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Incidents" fx:id="trendYAxis"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </GridPane>

            <!-- Bottom Section: Suspicious Clusters & Findings Table -->
            <VBox spacing="12.0" styleClass="white-card">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label text="Suspicious Clusters &amp; Machine Learning Findings" styleClass="section-title"/>
                        <Label fx:id="anomalyCountLabel" text="Showing 0 anomalies" styleClass="section-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="anomaliesTable" prefHeight="260.0">
                    <columns>
                        <TableColumn fx:id="colSeverity" text="SEVERITY" prefWidth="95.0"/>
                        <TableColumn fx:id="colScore" text="SCORE" prefWidth="75.0"/>
                        <TableColumn fx:id="colEventType" text="EVENT TYPE" prefWidth="130.0"/>
                        <TableColumn fx:id="colReason" text="ANOMALY REASON / PATTERN" prefWidth="280.0"/>
                        <TableColumn fx:id="colMethod" text="DETECTION METHOD" prefWidth="160.0"/>
                        <TableColumn fx:id="colEventId" text="EVENT REF" prefWidth="100.0"/>
                        <TableColumn fx:id="colTimestamp" text="DATE" prefWidth="110.0"/>
                    </columns>
                    <placeholder>
                        <Label text="No anomalies detected for this investigation case."/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>

</StackPane>
