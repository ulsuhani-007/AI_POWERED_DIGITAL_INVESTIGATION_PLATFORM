<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="overlayPane" stylesheets="@../css/theme.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.investigation.controller.EvidenceController"
           style="-fx-background-color: #F1F5F9;">

    <VBox spacing="16.0" style="-fx-padding: 24px;">

        <!-- Header & Action Toolbar (Matches Reference Image Panel 5) -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="📁" style="-fx-font-size: 18px; -fx-text-fill: #0F172A;"/>
                <Label text="Evidence" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                <Label fx:id="activeCaseHeaderLabel" text="[Case C-001]"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #EFF6FF; -fx-padding: 3px 8px; -fx-background-radius: 6px;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Filter Button -->
            <MenuButton fx:id="filterMenuButton" text="Filter ▼" styleClass="btn-secondary">
                <items>
                    <MenuItem text="All Evidence" onAction="#onFilterAll"/>
                    <MenuItem text="Verified / Analyzed" onAction="#onFilterVerified"/>
                    <MenuItem text="Processing / Uploaded" onAction="#onFilterProcessing"/>
                </items>
            </MenuButton>

            <!-- View Mode Switcher -->
            <HBox spacing="2.0" style="-fx-background-color: #E2E8F0; -fx-background-radius: 6px; -fx-padding: 2px;">
                <Button fx:id="tableViewBtn" text="Table" onAction="#onShowTableView"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #0F172A; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 5px 12px; -fx-background-radius: 4px;"/>
                <Button fx:id="galleryViewBtn" text="Gallery" onAction="#onShowGalleryView"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: 600; -fx-font-size: 11px; -fx-padding: 5px 12px;"/>
            </HBox>

            <!-- + Add Evidence Button -->
            <Button text="+ Add Evidence" onAction="#onOpenUploadDialog" styleClass="btn-primary"
                    style="-fx-font-size: 13px; -fx-padding: 8px 16px;"/>

            <!-- Refresh Button -->
            <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary"/>
        </HBox>

        <!-- Main Content Split: Table (Left) + Details Card (Right) -->
        <SplitPane dividerPositions="0.70" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">

            <!-- Table Section -->
            <VBox spacing="8.0" styleClass="white-card" style="-fx-padding: 0;">
                <TableView fx:id="evidenceTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIcon" text="" prefWidth="48.0" resizable="false"/>
                        <TableColumn fx:id="colEvidenceId" text="EVIDENCE ID" prefWidth="120.0"/>
                        <TableColumn fx:id="colFileName" text="FILE NAME" prefWidth="220.0"/>
                        <TableColumn fx:id="colType" text="TYPE" prefWidth="80.0"/>
                        <TableColumn fx:id="colCase" text="CASE" prefWidth="90.0"/>
                        <TableColumn fx:id="colCollector" text="COLLECTED BY" prefWidth="130.0"/>
                        <TableColumn fx:id="colDate" text="COLLECTED AT" prefWidth="110.0"/>
                        <TableColumn fx:id="colStatus" text="STATUS" prefWidth="110.0"/>
                    </columns>
                    <placeholder>
                        <Label text="No evidence records found for this active case."/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Evidence Detail & Inspection Panel -->
            <VBox fx:id="detailsBox" spacing="12.0" styleClass="white-card">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="detailFileName" text="Evidence Details" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailStatus" text="Verified" styleClass="badge-verified"/>
                </HBox>

                <Separator/>

                <GridPane vgap="8.0" hgap="12.0">
                    <Label text="File Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailType" text="CSV Document" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                    <Label text="File Size:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailSize" text="--" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-text-fill: #0F172A;"/>

                    <Label text="Ingested At:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailDate" text="--" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-text-fill: #0F172A;"/>

                    <Label text="Normalized Events:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailEvents" text="--" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                </GridPane>

                <Separator/>

                <VBox spacing="4.0">
                    <Label text="SHA-256 CRYPTOGRAPHIC HASH" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailHash" text="--" style="-fx-font-family: monospace; -fx-font-size: 11px; -fx-text-fill: #0F172A; -fx-background-color: #F8FAFC; -fx-padding: 6px 8px; -fx-background-radius: 4px; -fx-border-color: #E2E8F0; -fx-border-radius: 4px;" wrapText="true"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="DESCRIPTION / CHAIN OF CUSTODY NOTE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailDescription" text="--" style="-fx-font-size: 12px; -fx-text-fill: #475569;" wrapText="true"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="8.0">
                    <Button text="View Timeline Events →" onAction="#onJumpToTimelineForEvidence" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnDeleteEvidence" text="Delete Evidence" onAction="#onDeleteEvidence" styleClass="btn-danger" style="-fx-font-size: 12px; -fx-padding: 6px 12px;"/>
                </HBox>
            </VBox>

        </SplitPane>

    </VBox>

</StackPane>
