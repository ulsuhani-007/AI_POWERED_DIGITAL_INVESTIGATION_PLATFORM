<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="overlayPane" stylesheets="@../css/theme.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.investigation.controller.GraphController"
           style="-fx-background-color: #F1F5F9;">

    <VBox spacing="16.0" style="-fx-padding: 24px;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="🕸" style="-fx-font-size: 18px; -fx-text-fill: #0F172A;"/>
                <Label text="Relationship Graph" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                <Label fx:id="activeCaseHeaderLabel" text="[Case C-001]"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #EFF6FF; -fx-padding: 3px 8px; -fx-background-radius: 6px;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Entity Search -->
            <HBox alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 2 10 2 10;">
                <Label text="🔍" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <TextField fx:id="nodeSearchField" promptText="Search entity or IP..." prefWidth="180.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 6 0 6 0; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Zoom & View Controls -->
            <HBox spacing="6.0" alignment="CENTER_RIGHT">
                <Button fx:id="zoomInButton" text="🔍+" styleClass="btn-secondary" tooltip="$zoomInTip">
                    <tooltip><Tooltip fx:id="zoomInTip" text="Zoom In"/></tooltip>
                </Button>
                <Button fx:id="zoomOutButton" text="🔍-" styleClass="btn-secondary" tooltip="$zoomOutTip">
                    <tooltip><Tooltip fx:id="zoomOutTip" text="Zoom Out"/></tooltip>
                </Button>
                <Button fx:id="resetViewButton" text="⛶ Reset" styleClass="btn-secondary"/>
                <ToggleButton fx:id="physicsToggle" text="Physics" selected="true" styleClass="btn-secondary"/>
            </HBox>

            <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary"/>
        </HBox>

        <!-- Main Split: Canvas with Floating Legend (Left) + Detail Inspector (Right) -->
        <SplitPane dividerPositions="0.75" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">

            <!-- Canvas Container with Floating Legend Card -->
            <StackPane styleClass="white-card" style="-fx-padding: 0;">
                <!-- Graph Canvas placed here -->
                <StackPane fx:id="graphContainer"/>

                <!-- Floating Legend Card (Matches Reference Image Panel 8) -->
                <VBox StackPane.alignment="TOP_RIGHT" spacing="6.0"
                      style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 1);"
                      maxWidth="140" maxHeight="170">
                    <StackPane.margin>
                        <Insets top="16" right="16"/>
                    </StackPane.margin>

                    <Label text="Legend" style="-fx-font-size: 12px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="●" style="-fx-text-fill: #2563EB; -fx-font-size: 14px;"/>
                        <Label text="Person" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="●" style="-fx-text-fill: #1E40AF; -fx-font-size: 14px;"/>
                        <Label text="Evidence" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="●" style="-fx-text-fill: #D97706; -fx-font-size: 14px;"/>
                        <Label text="Location" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="●" style="-fx-text-fill: #DC2626; -fx-font-size: 14px;"/>
                        <Label text="Event / Suspect" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    </HBox>
                </VBox>
            </StackPane>

            <!-- Entity Inspector Side Panel -->
            <VBox fx:id="detailPanel" spacing="12.0" styleClass="white-card">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="detailNodeType" text="ENTITY INSPECTOR" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailConnectedCount" text="0 Edges" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                </HBox>

                <Label fx:id="detailNodeLabel" text="No Node Selected" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" wrapText="true"/>
                <Label fx:id="detailNodeSubtitle" text="Click any entity node to inspect investigative link properties." style="-fx-font-size: 12px; -fx-text-fill: #64748B;" wrapText="true"/>

                <Separator/>

                <!-- Dynamic Metadata Properties -->
                <Label text="NODE ATTRIBUTES" styleClass="stat-label"/>
                <ScrollPane fitToWidth="true" prefHeight="180.0" style="-fx-background-color: transparent;">
                    <VBox fx:id="dynamicPropertiesBox" spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-padding: 10px; -fx-background-radius: 6px; -fx-border-color: #E2E8F0; -fx-border-radius: 6px;">
                        <!-- Key-Value pairs injected here -->
                    </VBox>
                </ScrollPane>

                <!-- Incident Relationships -->
                <Label text="INCIDENT RELATIONSHIPS" styleClass="stat-label"/>
                <ScrollPane fitToWidth="true" prefHeight="160.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="connectedNeighborsBox" spacing="6.0">
                        <!-- Populated with neighbor cards -->
                    </VBox>
                </ScrollPane>
            </VBox>

        </SplitPane>

    </VBox>

</StackPane>

