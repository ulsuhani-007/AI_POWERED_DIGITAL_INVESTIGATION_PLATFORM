<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="overlayPane" stylesheets="@../css/theme.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.investigation.controller.TimelineController"
           style="-fx-background-color: #F1F5F9;">

    <VBox spacing="16.0" style="-fx-padding: 24px;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="⏱" style="-fx-font-size: 18px; -fx-text-fill: #0F172A;"/>
                <Label text="Timeline" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                <Label fx:id="activeCaseHeaderLabel" text="[Case C-001]"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #EFF6FF; -fx-padding: 3px 8px; -fx-background-radius: 6px;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search Field -->
            <HBox alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 2 10 2 10;">
                <Label text="🔍" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <TextField fx:id="searchField" promptText="Filter events by IP, user, desc..." prefWidth="220.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 6 0 6 0; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Event Category Filter -->
            <ComboBox fx:id="eventTypeComboBox" prefWidth="150.0" promptText="Event Type"/>

            <!-- Sort Toggle -->
            <ToggleButton fx:id="sortOrderToggle" text="⏱ Newest First" selected="true" styleClass="btn-secondary"/>

            <!-- Refresh Button -->
            <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary"/>
        </HBox>

        <!-- Main Split: Timeline Cards List (Left) + Event Details (Right) -->
        <SplitPane dividerPositions="0.68" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">

            <!-- Timeline Card Feed -->
            <VBox spacing="8.0" styleClass="white-card" style="-fx-padding: 12px;">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="eventCountLabel" text="Showing 0 events" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Click an event to inspect forensic details" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                </HBox>

                <ListView fx:id="eventsListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
            </VBox>

            <!-- Event Details Card -->
            <VBox fx:id="detailPanel" spacing="12.0" styleClass="white-card">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Event Forensics" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailEventType" text="LOGIN" styleClass="badge-info"/>
                </HBox>

                <Separator/>

                <GridPane vgap="8.0" hgap="12.0">
                    <Label text="Timestamp:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailTimestamp" text="--" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                    <Label text="Actor / User:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailUser" text="--" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>

                    <Label text="Source IP:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailIp" text="--" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-family: monospace; -fx-text-fill: #0F172A;"/>

                    <Label text="Host / Device:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailDevice" text="--" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-text-fill: #0F172A;"/>

                    <Label text="Result:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailSuccess" text="--" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>

                    <Label text="Payload Bytes:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailBytes" text="--" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-font-size: 12px; -fx-text-fill: #0F172A;"/>
                </GridPane>

                <Separator/>

                <VBox spacing="4.0">
                    <Label text="EVENT DESCRIPTION / ACTION" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <TextArea fx:id="detailDescriptionArea" editable="false" prefRowCount="4" wrapText="true"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-text-fill: #0F172A; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="SOURCE EVIDENCE ARTIFACT" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                    <Label fx:id="detailEvidenceId" text="--" style="-fx-font-size: 11px; -fx-font-family: monospace; -fx-text-fill: #2563EB;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="8.0">
                    <Button text="Inspect in Relationship Graph →" onAction="#onJumpToGraph" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

        </SplitPane>

    </VBox>

</StackPane>
