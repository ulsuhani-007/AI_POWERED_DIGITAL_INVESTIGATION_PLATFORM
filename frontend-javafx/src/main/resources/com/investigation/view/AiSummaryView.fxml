<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="overlayPane" stylesheets="@../css/theme.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.investigation.controller.AiSummaryController"
           style="-fx-background-color: #F1F5F9;">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F1F5F9;">
        <VBox spacing="18.0" style="-fx-padding: 24px;">

            <!-- Header (Matches Reference Image Panel 10) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="🤖" style="-fx-font-size: 20px; -fx-text-fill: #2563EB;"/>
                    <Label text="AI-Assisted Forensic Summary" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="activeCaseHeaderLabel" text="[Case C-001]"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #EFF6FF; -fx-padding: 3px 8px; -fx-background-radius: 6px;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📋 Copy Text" onAction="#onCopySummary" styleClass="btn-secondary"/>
                <Button text="📥 Export" onAction="#onExportReport" styleClass="btn-secondary"/>
                <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary"/>
            </HBox>

            <!-- 2-Column Grid of 6 Structured Report Sections -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>

                <!-- Section 1: Investigation Overview -->
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" spacing="8.0" styleClass="white-card">
                    <Label text="Investigation Overview" styleClass="section-title"/>
                    <Label fx:id="overviewText" text="Detailed analysis of digital evidence suggests structured operational activity across multiple endpoints and temporal clusters."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>

                <!-- Section 2: Suspicious Activity -->
                <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="8.0" styleClass="white-card">
                    <Label text="Suspicious Activity" styleClass="section-title"/>
                    <Label fx:id="suspiciousActivityText" text="Unusual login patterns were observed during off-hours windows outside standard shift boundaries, indicating credential misuse."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>

                <!-- Section 3: Key Findings -->
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" spacing="8.0" styleClass="white-card">
                    <Label text="Key Findings" styleClass="section-title"/>
                    <Label fx:id="keyFindingsText" text="Multiple suspicious activities were detected by automated ML detectors with confidence scores ranging between 0.75 and 0.92."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>

                <!-- Section 4: Anomaly Analysis -->
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="8.0" styleClass="white-card">
                    <Label text="Anomaly Analysis" styleClass="section-title"/>
                    <Label fx:id="anomalyAnalysisText" text="High-severity anomalies found across telemetry logs correlate with unexpected file modification actions and unauthorized access attempts."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>

                <!-- Section 5: Timeline Highlights -->
                <VBox GridPane.rowIndex="2" GridPane.columnIndex="0" spacing="8.0" styleClass="white-card">
                    <Label text="Timeline Highlights" styleClass="section-title"/>
                    <Label fx:id="timelineHighlightsText" text="Key events include initial boundary penetration at 03:12 followed by persistent file modifications and dispatch log adjustments."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>

                <!-- Section 6: Investigation Conclusion -->
                <VBox GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="8.0" styleClass="white-card">
                    <Label text="Investigation Conclusion" styleClass="section-title"/>
                    <Label fx:id="conclusionText" text="The evidence indicates a strong evidentiary correlation between internal insider activity and external network access tokens."
                           style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true"/>
                </VBox>
            </GridPane>

            <!-- Bottom Center Action: Generate Report Button -->
            <HBox alignment="CENTER" style="-fx-padding: 10 0 10 0;">
                <Button text="📄  Generate Report" onAction="#onGenerateReport" styleClass="btn-primary"
                        style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-padding: 10px 28px; -fx-background-radius: 8px;"/>
            </HBox>

        </VBox>
    </ScrollPane>

</StackPane>
